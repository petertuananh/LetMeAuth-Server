<link rel="stylesheet" href="/assets/css/form.css">
<link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Rubik:400,700'>
<link rel="shortcut icon" href="/assets/images/shield.png" />
<body>
    <!-- partial:index.partial.html -->
    <div class="login-form">
        <form method="post" action="/user/setting/2fa?target=enable&secret=<%= twofactor.secret %>">
            <h1>Enable 2FA</h1>
            <div class="content">
                <div class="input-field">
                    <p>Secret : <%= twofactor.secret %> </p>
            </div>
                <div class="input-field">
                    <img src="<%= twofactor.qr %>" alt="">
                </div>
                <div class="input-field">
                    <input type="text" name="twofactor" placeholder="2FA" autocomplete="nope">
                </div>
            </div>
            <div class="action">
                <button type="submit">Enable</button>
            </div>
        </form>
    </div>
    <!-- partial -->
    <script src="/assets/js/login.js"></script>

</body>

</html>
<script>
    if ('<%= msg %>' !== 'no') {
        alert('<%= msg %>')
    }
</script>
